<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/PlayerButton"
            android:background="@drawable/bg_btn_back"
            android:src="@drawable/ic_btn_back"
            android:contentDescription="@string/back" />

        <ImageButton
            android:id="@+id/btnPlay"
            style="@style/PlayerButton"
            android:background="@drawable/bg_btn_play_selector"
            android:src="@drawable/ic_btn_play"
            android:contentDescription="@string/slide_show" />

        <ImageButton
            android:id="@+id/btnSound"
            style="@style/PlayerButton"
            android:background="@drawable/bg_btn_sound_selector"
            android:src="@drawable/ic_btn_sound_on"
            android:contentDescription="@string/sound" />

        <ImageButton
            android:id="@+id/btnLock"
            style="@style/PlayerButton"
            android:background="@drawable/bg_btn_lock_selector"
            android:src="@drawable/ic_btn_lock"
            android:contentDescription="@string/lock" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
